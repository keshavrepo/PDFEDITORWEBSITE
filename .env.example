# Required: PostgreSQL connection used by Drizzle.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public origin, without a trailing slash.
NEXTAUTH_URL=http://localhost:3000

# Optional Google sign-in (both values are required to enable it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional email. Password reset and contact messages use the
# Resend HTTP API when configured.
RESEND_API_KEY=
EMAIL_FROM=PDFPilot <no-reply@example.com>
SUPPORT_EMAIL=support@example.com

# Optional Stripe billing. All values are required to enable paid checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

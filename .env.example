# Required: PostgreSQL connection used by Drizzle.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public origin, without a trailing slash.
NEXTAUTH_URL=http://localhost:3000

# Optional Google sign-in (both values are required to enable it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional transactional email. Password reset and contact messages use the
# Resend HTTP API when configured.
RESEND_API_KEY=
EMAIL_FROM=PDFPilot <launchstack.in@gmail.com>
SUPPORT_EMAIL=launchstack.in@gmail.com

# One-time administrator bootstrap. Choose a unique 12+ character password,
# run `npm run admin:create`, then remove ADMIN_PASSWORD from the environment.
ADMIN_EMAIL=keshavchouchan78@gmail.com
ADMIN_NAME=Keshav
ADMIN_PASSWORD=

# Recommended in production for durable blog image storage. Local development
# falls back to public/uploads/blog; Vercel deployments require this token.
BLOB_READ_WRITE_TOKEN=

# Optional Stripe billing. All values are required to enable paid checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
